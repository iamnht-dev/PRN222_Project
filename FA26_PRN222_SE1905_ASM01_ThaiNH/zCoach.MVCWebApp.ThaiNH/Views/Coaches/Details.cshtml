@model zCoach.Entities.ThaiNH.Models.CoachThaiNh

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>
<section id="coachDetails" data-coach-id="@Model.CoachThaiNhid">
<p id="detailsLiveStatus" class="text-muted" role="status">Connecting to live updates...</p>
<div id="detailsDeleted" class="alert alert-warning" role="alert" hidden>Coach này đã được xoá. <a asp-action="Index">Back to List</a></div>

<div>
    <h4>CoachThaiNh</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FullName)
        </dt>
        <dd class="col-sm-10" data-coach-field="fullName">
            @Html.DisplayFor(model => model.FullName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-10" data-coach-field="email">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Phone)
        </dt>
        <dd class="col-sm-10" data-coach-field="phone">
            @Html.DisplayFor(model => model.Phone)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DateOfBirth)
        </dt>
        <dd class="col-sm-10" data-coach-field="dateOfBirth">
            @Html.DisplayFor(model => model.DateOfBirth)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Gender)
        </dt>
        <dd class="col-sm-10" data-coach-field="gender">
            @Html.DisplayFor(model => model.Gender)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Address)
        </dt>
        <dd class="col-sm-10" data-coach-field="address">
            @Html.DisplayFor(model => model.Address)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ImageUrl)
        </dt>
        <dd class="col-sm-10" data-coach-field="imageUrl">
            @Html.DisplayFor(model => model.ImageUrl)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Experience)
        </dt>
        <dd class="col-sm-10" data-coach-field="experience">
            @Html.DisplayFor(model => model.Experience)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Certification)
        </dt>
        <dd class="col-sm-10" data-coach-field="certification">
            @Html.DisplayFor(model => model.Certification)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Salary)
        </dt>
        <dd class="col-sm-10" data-coach-field="salary">
            @Html.DisplayFor(model => model.Salary)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.HireDate)
        </dt>
        <dd class="col-sm-10" data-coach-field="hireDate">
            @Html.DisplayFor(model => model.HireDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10" data-coach-field="status">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PublishDate)
        </dt>
        <dd class="col-sm-10" data-coach-field="publishDate">
            @Html.DisplayFor(model => model.PublishDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.UpdateAt)
        </dt>
        <dd class="col-sm-10" data-coach-field="updateAt">
            @Html.DisplayFor(model => model.UpdateAt)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IsActive)
        </dt>
        <dd class="col-sm-10" data-coach-field="isActive">
            @Html.DisplayFor(model => model.IsActive)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SpecializationThaiNh)
        </dt>
        <dd class="col-sm-10" data-coach-field="specializationName">
            @(Model.SpecializationThaiNh?.SpecializationName ?? "General")
        </dd>
    </dl>
</div>
<div>
    <a id="detailsEditLink" asp-action="Edit" asp-route-id="@Model?.CoachThaiNhid">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>

</section>
@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/coach-details-signalr.js" asp-append-version="true"></script>
}
