@model IEnumerable<zCoach.Entities.ThaiNH.Models.CoachThaiNh>

@{
    ViewData["Title"] = "Coach Roster";
}

<h2 class="text-primary fw-bold mb-4">🏋️‍♂️ Coach Roster</h2>
<p id="hubStatus" class="text-muted" role="status">Connecting to live updates...</p>

<form asp-action="Index" method="get" class="mb-4 bg-light p-3 rounded shadow-sm border">
    <div class="row">
        <div class="col-md-3">
            <div class="form-group">
                <label class="control-label mb-1 fw-bold">Coach Name</label>
                <input type="text" name="fullName" value="@ViewBag.SearchName" class="form-control" placeholder="Search name..." />
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label class="control-label mb-1 fw-bold">Email</label>
                <input type="text" name="email" value="@ViewBag.SearchEmail" class="form-control" placeholder="Search email..." />
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label class="control-label mb-1 fw-bold">Phone</label>
                <input type="text" name="phone" value="@ViewBag.SearchPhone" class="form-control" placeholder="Search phone..." />
            </div>
        </div>
        
        <div class="col-md-3 mt-4 d-flex justify-content-between align-items-start">
            <div class="form-group">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-1">Clear</a>
            </div>
        </div>
    </div>
</form>
<div class="mb-4 text-end">
    <button type="button" id="btnCoachCreate" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Create New Coach
    </button>
</div>

<table id="myTable" class="table table-bordered table-striped table-hover align-middle bg-white shadow-sm rounded overflow-hidden">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Avatar</th>
            <th>Full Name</th>
            <th>Specialization</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>@item.CoachThaiNhid</td>
                <td>
                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://cdn-icons-png.flaticon.com/512/3135/3135715.png" : item.ImageUrl)" 
                         class="rounded-circle object-fit-cover shadow-sm" 
                         style="width: 50px; height: 50px;" 
                         alt="Avatar">
                </td>
                <td class="fw-bold">@item.FullName</td>
                <td><span class="badge bg-primary">@(item.SpecializationThaiNh?.SpecializationName ?? "General")</span></td>
                <td>@item.Phone</td>
                <td>@item.Email</td>
                <td>
                    <button type="button" class="btn btn-sm btn-outline-primary btn-coach-edit" data-id="@item.CoachThaiNhid">Edit</button>
                    <a asp-action="Details" asp-route-id="@item.CoachThaiNhid" class="btn btn-sm btn-outline-info">Details</a>
                    <button type="button" class="btn btn-sm btn-outline-danger btn-coach-delete" data-id="@item.CoachThaiNhid">Delete</button>


                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="signalRModal" tabindex="-1" aria-labelledby="signalRModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <form id="signalRCoachForm" class="modal-content" method="post" action="/Coaches/Create">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 id="signalRModalLabel" class="modal-title fs-5">Create Coach</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p id="signalRFormError" class="text-danger" role="alert"></p>
                    <input id="srCoachThaiNhid" name="CoachThaiNhid" type="hidden" value="0" />
                    <p id="deleteConfirmation" class="alert alert-warning" hidden></p>
                    <fieldset id="coachFields" class="row g-3">
                        <div class="col-md-6"><label for="srFullName" class="form-label">Full name</label><input id="srFullName" name="FullName" type="text" class="form-control" maxlength="250" required  /></div>
                        <div class="col-md-6"><label for="srEmail" class="form-label">Email</label><input id="srEmail" name="Email" type="email" class="form-control" maxlength="250"   /></div>
                        <div class="col-md-6"><label for="srPhone" class="form-label">Phone</label><input id="srPhone" name="Phone" type="tel" class="form-control" maxlength="20"   /></div>
                        <div class="col-md-6"><label for="srDateOfBirth" class="form-label">Date of birth</label><input id="srDateOfBirth" name="DateOfBirth" type="date" class="form-control"    /></div>
                        <div class="col-md-6"><label for="srGender" class="form-label">Gender</label><input id="srGender" name="Gender" type="text" class="form-control" maxlength="10"   /></div>
                        <div class="col-md-6"><label for="srAddress" class="form-label">Address</label><input id="srAddress" name="Address" type="text" class="form-control" maxlength="500"   /></div>
                        <div class="col-md-6"><label for="srImageUrl" class="form-label">Image URL</label><input id="srImageUrl" name="ImageUrl" type="text" class="form-control" maxlength="1000"   /></div>
                        <div class="col-md-6"><label for="srExperience" class="form-label">Experience</label><input id="srExperience" name="Experience" type="text" class="form-control" maxlength="500"   /></div>
                        <div class="col-md-6"><label for="srCertification" class="form-label">Certification</label><input id="srCertification" name="Certification" type="text" class="form-control" maxlength="500"   /></div>
                        <div class="col-md-6"><label for="srSalary" class="form-label">Salary</label><input id="srSalary" name="Salary" type="number" class="form-control"   min="0" step="0.01" /></div>
                        <div class="col-md-6"><label for="srHireDate" class="form-label">Hire date</label><input id="srHireDate" name="HireDate" type="date" class="form-control"    /></div>
                        <div class="col-md-6"><label for="srStatus" class="form-label">Status</label><input id="srStatus" name="Status" type="number" class="form-control"    /></div>
                        <div class="col-md-6"><label for="srPublishDate" class="form-label">Publish date</label><input id="srPublishDate" name="PublishDate" type="date" class="form-control"    /></div>
                        <div class="col-md-6"><label for="srSpecialization" class="form-label">Specialization</label><select id="srSpecialization" name="SpecializationThaiNhid" class="form-select"><option value="">-- Select --</option>
                            @foreach (var option in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Specializations)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select></div>
                        <div class="col-md-6"><label><input id="srIsActive" name="IsActive" type="checkbox" value="true" checked /> Active</label><input name="IsActive" type="hidden" value="false" /></div>
                    </fieldset>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button id="btnNormalSave" type="submit" class="btn btn-primary">Create</button>
                    <button id="btnSignalRSave" type="submit" class="btn btn-outline-success" disabled>Create by SignalR</button>
                </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center gap-3 mt-3">
    <label>Rows <select id="pageSize"><option selected>5</option><option>10</option><option>20</option><option>50</option></select></label>
    <span id="pageInfo" class="text-muted small"></span>
    <nav id="pager" aria-label="Coach pagination"></nav>
</div>
<script id="initialCoaches" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(zCoach.MVCWebApp.ThaiNH.Hubs.CoachHub.MapItem), new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)))</script>
@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/table-pagination.js" asp-append-version="true"></script>
    <script src="~/js/coaches-signalr.js" asp-append-version="true"></script>
}
