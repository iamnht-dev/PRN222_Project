    <form id="deleteForm" onsubmit="event.preventDefault(); deleteCoach();">
        <input type="hidden" id="CoachThaiNhid" value="@Model.CoachThaiNhid" />
        <input type="submit" value="Delete via SignalR" class="btn btn-danger" /> |
