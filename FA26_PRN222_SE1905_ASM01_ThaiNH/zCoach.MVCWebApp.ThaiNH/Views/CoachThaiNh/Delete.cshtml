@section Scripts {
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script>
        var connection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();
        connection.start();

        function deleteCoach() {
            var id = document.getElementById("CoachThaiNhid").value;
            connection.invoke("HubDelete_ICoachThaiNh", id).then(function () {
                window.location.href = '@Url.Action("Index", "CoachThaiNh")';
            }).catch(function (err) {
                return console.error(err.toString());
            });
        }
    </script>
}
