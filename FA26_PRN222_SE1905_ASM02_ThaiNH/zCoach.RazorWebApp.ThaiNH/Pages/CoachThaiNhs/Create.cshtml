@page
@model zCoach.RazorWebApp.ThaiNH.Pages.CoachThaiNhs.CreateModel
@{
    ViewData["Title"] = "Create Coach";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Create Coach</h1>
        <p class="text-muted mb-0">Tạo mới bằng Razor Pages.</p>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary">Quay lại</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            <partial name="_FormFields" model="Model" />
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Huỷ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
