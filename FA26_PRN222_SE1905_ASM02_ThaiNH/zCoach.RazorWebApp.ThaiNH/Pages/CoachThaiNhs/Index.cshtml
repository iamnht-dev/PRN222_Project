@page
@model zCoach.RazorWebApp.ThaiNH.Pages.CoachThaiNhs.IndexModel
@{ ViewData["Title"] = "Coaches"; }

<h2 class="text-primary fw-bold mb-4">🏋️‍♂️ Coach Roster</h2>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<form method="get" class="mb-4 bg-light p-3 rounded shadow-sm border">
    <div class="row g-2"><div class="col-md-3"><label for="searchFullName" class="control-label mb-1 fw-bold">Coach Name</label><input id="searchFullName" name="FullName" value="@Model.FullName" class="form-control" /></div><div class="col-md-3"><label for="searchEmail" class="control-label mb-1 fw-bold">Email</label><input id="searchEmail" name="Email" value="@Model.Email" class="form-control" /></div><div class="col-md-3"><label for="searchPhone" class="control-label mb-1 fw-bold">Phone</label><input id="searchPhone" name="Phone" value="@Model.Phone" class="form-control" /></div><div class="col-md-3 align-self-end"><button class="btn btn-primary">Search</button> <a asp-page="Index" class="btn btn-outline-secondary">Clear</a></div></div>
</form>

<div class="mb-4 text-end"><button type="button" class="btn btn-success js-open-create">Create New Coach</button></div>
<div class="table-responsive"><table id="coachTable" class="table table-bordered table-striped table-hover align-middle bg-white shadow-sm rounded overflow-hidden"><thead class="table-dark"><tr><th>ID</th><th>Avatar</th><th>Full Name</th><th>Specialization</th><th>Phone</th><th>Email</th><th>Actions</th></tr></thead><tbody>
@foreach (var item in Model.Coaches) { <tr><td>@item.CoachThaiNhid</td><td><img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://cdn-icons-png.flaticon.com/512/3135/3135715.png" : item.ImageUrl)" class="rounded-circle object-fit-cover shadow-sm" style="width:50px;height:50px" alt="Avatar" /></td><td class="fw-bold">@item.FullName</td><td><span class="badge bg-primary">@(item.SpecializationThaiNh?.SpecializationName ?? "General")</span></td><td>@item.Phone</td><td>@item.Email</td><td><a asp-page="Details" asp-route-id="@item.CoachThaiNhid" class="btn btn-sm btn-outline-info">Details</a> <button type="button" class="btn btn-sm btn-outline-primary js-open-edit" data-id="@item.CoachThaiNhid">Edit</button> <button type="button" class="btn btn-sm btn-outline-danger js-open-delete" data-id="@item.CoachThaiNhid">Delete</button></td></tr> }
</tbody></table></div>
<div class="d-flex justify-content-between"><label>Rows <select id="pageSize"><option>5</option><option selected>10</option><option>20</option><option>50</option></select></label><span id="pageInfo"></span><nav id="pager" aria-label="Pagination"></nav></div>

<div class="modal fade" id="coachModal" tabindex="-1" aria-labelledby="coachModalTitle" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-scrollable"><form id="coachForm" method="post" class="modal-content" data-create-url="@Url.Page("./Index", "Create")" data-edit-url="@Url.Page("./Index", "Edit")">@Html.AntiForgeryToken()<div class="modal-header"><h2 id="coachModalTitle" class="modal-title fs-5">Create Coach</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input name="Editor.CoachThaiNhid" type="hidden" value="0" /><div class="row g-3">
<div class="col-md-6"><label class="form-label">Full name</label><input name="Editor.FullName" class="form-control" maxlength="250" required /></div><div class="col-md-6"><label class="form-label">Email</label><input name="Editor.Email" type="email" class="form-control" maxlength="250" /></div><div class="col-md-6"><label class="form-label">Phone</label><input name="Editor.Phone" type="tel" class="form-control" maxlength="10" pattern="0[0-9]{9}" /></div><div class="col-md-6"><label class="form-label">Date of birth</label><input name="Editor.DateOfBirth" type="date" class="form-control" /></div><div class="col-md-6"><label class="form-label">Gender</label><input name="Editor.Gender" class="form-control" maxlength="10" /></div><div class="col-md-6"><label class="form-label">Address</label><input name="Editor.Address" class="form-control" maxlength="500" /></div><div class="col-md-6"><label class="form-label">Image URL</label><input name="Editor.ImageUrl" class="form-control" maxlength="1000" /></div><div class="col-md-6"><label class="form-label">Experience</label><input name="Editor.Experience" class="form-control" maxlength="500" /></div><div class="col-md-6"><label class="form-label">Certification</label><input name="Editor.Certification" class="form-control" maxlength="500" /></div><div class="col-md-6"><label class="form-label">Salary</label><input name="Editor.Salary" type="number" class="form-control" min="0" step="0.01" /></div><div class="col-md-6"><label class="form-label">Hire date</label><input name="Editor.HireDate" type="date" class="form-control" /></div><div class="col-md-6"><label class="form-label">Status</label><input name="Editor.Status" type="number" class="form-control" /></div><div class="col-md-6"><label class="form-label">Publish date</label><input name="Editor.PublishDate" type="date" class="form-control" /></div><div class="col-md-6"><label class="form-label">Specialization</label><select name="Editor.SpecializationThaiNhid" class="form-select"><option value="">-- Select --</option>@foreach(var option in Model.Specializations){<option value="@option.SpecializationThaiNhid">@option.SpecializationName</option>}</select></div><div class="col-md-6"><label><input name="Editor.IsActive" type="checkbox" value="true" checked /> Active</label><input name="Editor.IsActive" type="hidden" value="false" /></div>
</div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button id="coachSaveButton" type="submit" class="btn btn-primary">Create</button></div></form></div></div>
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalTitle" aria-hidden="true"><div class="modal-dialog"><form method="post" action="@Url.Page("./Index", "Delete")" class="modal-content">@Html.AntiForgeryToken()<input id="deleteCoachId" name="id" type="hidden" /><div class="modal-header"><h2 id="deleteModalTitle" class="modal-title fs-5">Delete Coach</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><p id="deleteCoachText" class="mb-0"></p></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger">Delete</button></div></form></div></div>

<script id="coachData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Coaches.Select(x => new { x.CoachThaiNhid, x.FullName, x.Email, x.Phone, DateOfBirth = x.DateOfBirth?.ToString("yyyy-MM-dd"), x.Gender, x.Address, x.ImageUrl, x.Experience, x.Certification, x.Salary, HireDate = x.HireDate?.ToString("yyyy-MM-dd"), x.Status, PublishDate = x.PublishDate?.ToString("yyyy-MM-dd"), x.SpecializationThaiNhid, x.IsActive }), new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)))</script>
@section Scripts { <script>
$(function(){ tablePagination.init({table:'#coachTable',pager:'#pager',info:'#pageInfo',pageSizeSelector:'#pageSize',pageSize:10});
 const coaches=JSON.parse(document.getElementById('coachData').textContent), form=document.getElementById('coachForm'), modal=new bootstrap.Modal('#coachModal'), deleteModal=new bootstrap.Modal('#deleteModal');
 const set=(name,value)=>{const field=form.elements[name];if(!field)return;if(field.type==='checkbox')field.checked=Boolean(value);else field.value=value ?? '';};
 $('.js-open-create').on('click',function(){form.reset();form.action=form.dataset.createUrl;set('Editor.CoachThaiNhid',0);set('Editor.PublishDate',new Date().toISOString().slice(0,10));set('Editor.IsActive',true);$('#coachModalTitle').text('Create Coach');$('#coachSaveButton').text('Create');modal.show();});
 $('.js-open-edit').on('click',function(){const item=coaches.find(x=>x.coachThaiNhid===Number(this.dataset.id));if(!item)return;form.action=form.dataset.editUrl;Object.entries(item).forEach(([key,value])=>set('Editor.'+key.charAt(0).toUpperCase()+key.slice(1),value));$('#coachModalTitle').text('Edit Coach');$('#coachSaveButton').text('Edit');modal.show();});
 $('.js-open-delete').on('click',function(){const item=coaches.find(x=>x.coachThaiNhid===Number(this.dataset.id));if(!item)return;$('#deleteCoachId').val(item.coachThaiNhid);$('#deleteCoachText').text('Delete Coach #'+item.coachThaiNhid+' ('+item.fullName+')?');deleteModal.show();});
}); </script> }
