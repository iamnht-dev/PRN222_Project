@page
@model zCoach.RazorWebApp.ThaiNH.Pages.CoachThaiNhs.IndexModel
@{ ViewData["Title"]="Coaches"; }
<h2 class="text-primary fw-bold mb-4">🏋️‍♂️ Coach Roster</h2>
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}
@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}

<form method="get" class="mb-4 bg-light p-3 rounded shadow-sm border"><div class="row g-2"><div class="col-md-3"><label for="searchFullName" class="control-label mb-1 fw-bold">Coach Name</label><input id="searchFullName" name="FullName" value="@(Model.FullName)" class="form-control" /></div><div class="col-md-3"><label for="searchEmail" class="control-label mb-1 fw-bold">Email</label><input id="searchEmail" name="Email" value="@(Model.Email)" class="form-control" /></div><div class="col-md-3"><label for="searchPhone" class="control-label mb-1 fw-bold">Phone</label><input id="searchPhone" name="Phone" value="@(Model.Phone)" class="form-control" /></div><div class="col-md-3 align-self-end"><button class="btn btn-primary">Search</button> <a asp-page="Index" class="btn btn-outline-secondary">Clear</a></div></div></form><div class="mb-4 text-end"><a asp-page="Create" class="btn btn-success">Create New Coach</a> </div><div class="table-responsive"><table id="coachTable" class="table table-bordered table-striped table-hover align-middle bg-white shadow-sm rounded overflow-hidden"><thead class="table-dark"><tr><th>ID</th><th>Avatar</th><th>Full Name</th><th>Specialization</th><th>Phone</th><th>Email</th><th>Actions</th></tr></thead><tbody>
@foreach(var item in Model.Coaches) {
<tr><td>@item.CoachThaiNhid</td><td><img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://cdn-icons-png.flaticon.com/512/3135/3135715.png" : item.ImageUrl)" class="rounded-circle object-fit-cover shadow-sm" style="width:50px;height:50px" alt="Avatar" /></td><td class="fw-bold">@item.FullName</td><td><span class="badge bg-primary">@(item.SpecializationThaiNh?.SpecializationName ?? "General")</span></td><td>@item.Phone</td><td>@item.Email</td><td><a asp-page="Details" asp-route-id="@item.CoachThaiNhid" class="btn btn-sm btn-outline-info">Details</a> <a asp-page="Edit" asp-route-id="@item.CoachThaiNhid" class="btn btn-sm btn-outline-primary">Edit</a> <a asp-page="Delete" asp-route-id="@item.CoachThaiNhid" class="btn btn-sm btn-outline-danger">Delete</a>  </td></tr>
}</tbody></table></div><div class="d-flex justify-content-between"><label>Rows <select id="pageSize"><option>5</option><option selected>10</option><option>20</option><option>50</option></select></label><span id="pageInfo"></span><nav id="pager" aria-label="Pagination"></nav></div>

@section Scripts {
    <script>$(function(){tablePagination.init({table:'#coachTable',pager:'#pager',info:'#pageInfo',pageSizeSelector:'#pageSize',pageSize:10});});</script>
}
