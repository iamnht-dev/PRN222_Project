@model zCoach.RazorWebApp.ThaiNH.Pages.CoachThaiNhs.CoachFormPageModel
<div asp-validation-summary="ModelOnly" class="text-danger"></div><input type="hidden" asp-for="Coach.CoachThaiNhid" /><div class="row g-3"><div class="col-md-6"><label asp-for="Coach.FullName" class="form-label">Full name</label><input asp-for="Coach.FullName" type="text"  class="form-control" /><span asp-validation-for="Coach.FullName" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Coach.Email" class="form-label">Email</label><input asp-for="Coach.Email" type="email"  class="form-control" /><span asp-validation-for="Coach.Email" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Coach.Phone" class="form-label">Phone</label><input asp-for="Coach.Phone" type="tel"  class="form-control" /><span asp-validation-for="Coach.Phone" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Coach.DateOfBirth" class="form-label">Date of birth</label><input asp-for="Coach.DateOfBirth" type="date"  class="form-control" /><span asp-validation-for="Coach.DateOfBirth" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Coach.Gender" class="form-label">Gender</label><input asp-for="Coach.Gender" type="text"  class="form-control" /><span asp-validation-for="Coach.Gender" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Coach.Address" class="form-label">Address</label><input asp-for="Coach.Address" type="text"  class="form-control" /><span asp-validation-for="Coach.Address" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Coach.ImageUrl" class="form-label">Image URL</label><input asp-for="Coach.ImageUrl" type="text"  class="form-control" /><span asp-validation-for="Coach.ImageUrl" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Coach.Experience" class="form-label">Experience</label><input asp-for="Coach.Experience" type="text"  class="form-control" /><span asp-validation-for="Coach.Experience" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Coach.Certification" class="form-label">Certification</label><input asp-for="Coach.Certification" type="text"  class="form-control" /><span asp-validation-for="Coach.Certification" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Coach.Salary" class="form-label">Salary</label><input asp-for="Coach.Salary" type="number" step="0.01" class="form-control" /><span asp-validation-for="Coach.Salary" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Coach.HireDate" class="form-label">Hire date</label><input asp-for="Coach.HireDate" type="date"  class="form-control" /><span asp-validation-for="Coach.HireDate" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Coach.Status" class="form-label">Status</label><input asp-for="Coach.Status" type="number"  class="form-control" /><span asp-validation-for="Coach.Status" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Coach.PublishDate" class="form-label">Publish date</label><input asp-for="Coach.PublishDate" type="date"  class="form-control" /><span asp-validation-for="Coach.PublishDate" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Coach.SpecializationThaiNhid">Specialization</label><select asp-for="Coach.SpecializationThaiNhid" asp-items="@(ViewData["SpecializationThaiNhid"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">-- Select specialization --</option></select></div><div class="col-md-6"><label><input asp-for="Coach.IsActive" /> Active</label></div></div>